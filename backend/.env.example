ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://diploma_user:diploma_password@localhost:5432/diploma_db
LOCAL_AUTH_ENABLED=true
OIDC_ENABLED=false
CORS_ORIGINS=http://localhost:5173
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid,profile,email
OIDC_STATE_SECRET=replace-with-at-least-32-random-bytes
OIDC_SUCCESS_REDIRECT_URL=http://localhost:5173/
OIDC_ERROR_REDIRECT_URL=http://localhost:5173/login?error=oidc
OIDC_HANDSHAKE_TTL_SECONDS=600
SESSION_COOKIE_NAME=diploma_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
SESSION_TOUCH_INTERVAL_SECONDS=60
TRUSTED_HOSTS=localhost,127.0.0.1
